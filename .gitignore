# =============================================================================
# Student Early-Warning and Academic Support System — .gitignore
# =============================================================================

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/
.virtualenv/

# ── Environment / Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.secret
secrets.toml
.streamlit/secrets.toml

# ── Python Bytecode & Cache ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# ── Distribution / Packaging ──────────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
wheels/
*.whl

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS Artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ── Temporary / Log Files ─────────────────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*

# =============================================================================
# DATA — Exclude all raw and processed datasets (large files, not needed by app)
# =============================================================================
data/student_data.csv
data/processed/

# =============================================================================
# MODELS — Exclude large / non-deployed model artifacts; keep only best_model
# =============================================================================
models/decision_tree.joblib
models/logistic_regression.joblib
models/random_forest.joblib
models/xgboost.joblib
models/preprocessor.joblib

# ── Misc ──────────────────────────────────────────────────────────────────────
*.pkl
*.h5
*.hdf5
